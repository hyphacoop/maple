# The harness's boundary values: ports, identities, local credentials.
#
# compose.yml interpolates these, and every script sources them through lib.sh,
# so a port lives in exactly one place instead of being re-typed in a compose
# `ports:` entry, a healthcheck, an environment block and three shell scripts.
#
# These are not secrets. They are local-only literals, deliberately in the
# repository so the stack is reproducible; nothing here is used off this machine.

PLC_PORT=2582
PDS_PORT=2583
RELAY_PORT=2470
RELAY_METRICS_PORT=2471
# NOT 8080 — the Firestore emulator holds that.
JETSTREAM_PORT=6008
# jetstream's /healthz, /readyz and /metrics live on the debug listener only;
# its public mux serves / and /status.
JETSTREAM_DEBUG_PORT=6060

RELAY_ADMIN_PASSWORD=harness-admin
PDS_ADMIN_PASSWORD=harness-admin

# Deliberately NOT demo-dtp, which the consumer defaults to and the dev stack
# uses. A jetstream cursor is a seq in one host's sequence space, so harness
# runs and dev runs must not share a cursor document; separate projects make
# that structural rather than a thing to remember.
GCLOUD_PROJECT=demo-atp-local
FIRESTORE_EMULATOR_HOST=localhost:8080

HANDLE=maple.test
ACCOUNT_EMAIL=harness@maple.test
ACCOUNT_PASSWORD=harness-pass

# Image pins for the atproto stack (the local harness and the GCP stack).
#
# The one place the local compose stack reads image references from — and the
# file the Terraform in infra/gcp/ is meant to read too, so that local and dev
# cannot silently drift (infra/gcp/ does not exist yet). Change a pin
# here, not in a compose file or a .tf file.
#
# Boundary values — ports, identities, local credentials — live in endpoints.env.
#
# Resolved 2026-08-27:
#   pds       0.4.5027 is the newest version tag published to ghcr.
#   relay     indigo publishes cmd/relay per-commit as `relay-<sha>`; this is
#             main@0ae1607. There is no `latest` and no version tag.
#   jetstream v0.2.1 (released 2026-08-25) is the current v2 release.
#   plc       the official ghcr images (bluesky-social/did-method-plc) STOP at
#             2023-09-26 — the repo moved to the did-method-plc org and the
#             new org publishes nothing public. So PLC is built from a pinned
#             upstream commit instead of pulled. First `up` pays a few minutes
#             for that build; it is layer-cached afterwards.

ANCHOR_IMAGE=alpine:3.22
POSTGRES_IMAGE=postgres:16-alpine
# Used only by the relay-register escape hatch, for its stdlib sqlite3.
SQLITE_IMAGE=python:3.12-alpine

PDS_IMAGE=ghcr.io/bluesky-social/pds:0.4.5027
RELAY_IMAGE=ghcr.io/bluesky-social/indigo:relay-0ae16078d6a6137c0c93f8cbd6e486292dcea93a
JETSTREAM_IMAGE=ghcr.io/bluesky-social/jetstream:v0.2.1

# Split repo/ref so the '#' fragment never has to survive dotenv parsing.
PLC_GIT_REPO=https://github.com/did-method-plc/did-method-plc.git
PLC_GIT_REF=45a14801609e182afcd6907f95013cfb10381f73
